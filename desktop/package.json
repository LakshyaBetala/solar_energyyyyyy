{
  "name": "solara-desktop",
  "version": "1.0.0",
  "description": "Solara as a desktop app: its own window, the data kept in one folder outside the program.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win dir",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "in.solara.desktop",
    "productName": "Solara",
    "directories": { "output": "out" },
    "files": ["main.js", "splash.html"],
    "extraResources": [{ "from": "../dist/Solara", "to": "backend" }],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "deleteAppDataOnUninstall": false }
  }
}
