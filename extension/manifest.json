{
  "manifest_version": 3,
  "name": "Solara co-pilot",
  "version": "1.2.0",
  "description": "Fills government portal forms from Solara and reads their status lists, inside your own browser. You type every OTP and press every Submit.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8900/*",
    "http://localhost:8900/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://rts.mahadiscom.in/RoofTopSolarVendor/*",
        "https://pmsuryaghar.gov.in/*",
        "https://vendor.pmsuryaghar.gov.in/*",
        "https://consumer.pmsuryaghar.gov.in/*",
        "https://solardcrportal.nise.res.in/*",
        "https://www.jansamarth.in/*",
        "https://jansamarth.in/*",
        "http://127.0.0.1:8900/msedcl/*",
        "http://127.0.0.1:8900/portal/*",
        "http://127.0.0.1:8900/pmsg/*",
        "http://127.0.0.1:8900/dcr/*",
        "http://127.0.0.1:8900/jansamarth/*"
      ],
      "js": [
        "panel.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
