# Copy this file to  .env  and put your key in it. Nothing else needs changing.
# Without a key the product still works: extraction falls back to the deterministic
# parser, and the dashboard says "Model off" so you always know which path ran.

# Use ONE of these.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional: override the model. Defaults are claude-sonnet-5-5 / gpt-4.1-mini.
# SOLARA_MODEL=claude-sonnet-5-5

# The installer named on generated close-out documents.
# SOLARA_VENDOR_NAME=Your Solar Company Pvt Ltd
# SOLARA_VENDOR_SIGNATORY=Name of the authorised signatory
