# Copy this file to  .env  and put your key in it. Nothing else needs changing.
# Without a key the product still works: extraction falls back to the deterministic
# parser, and the dashboard says "Model off" so you always know which path ran.

# Use ONE of these.
# AI is OFF by default. Basic tasks (bill text, Aadhaar QR, validation) never use it.
# To allow it as a last resort for bills the rules cannot read, set BOTH:
# SOLARA_USE_AI=1
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional: override the model. Defaults are claude-sonnet-5-5 / gpt-4.1-mini.
# SOLARA_MODEL=claude-sonnet-5-5

# The installer named on generated close-out documents.
# SOLARA_VENDOR_NAME=Your Solar Company Pvt Ltd
# SOLARA_VENDOR_SIGNATORY=Name of the authorised signatory
# SOLARA_VENDOR_PHONE=+91 98XXXXXXXX          (shown to customers on their document page)
# Solara's internet address. Customers open their document and signing links on their own phones,
# so links must use an address reachable from the internet, never localhost:
# SOLARA_PUBLIC_URL=https://solara.example.in
